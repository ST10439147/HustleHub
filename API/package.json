{
  "name": "api",
  "version": "1.0.0",
  "description": "HustleHub+ secure backend API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:auth": "node middleware/auth.check.js",
    "test:totp": "node utils/totp.check.js",
    "test:gigs": "node controllers/gig.check.js",
    "test:bookings": "node controllers/booking.check.js",
    "test:income": "node controllers/income.check.js",
    "test:sanitize": "node middleware/sanitize.check.js",
    "test:logger": "node utils/logger.check.js",
    "test:api": "npx --yes newman run \"postman/HustleHub+ Part2.postman_collection.json\" --insecure",
    "test:api:part1": "npx --yes newman run \"postman/HustleHub+ Part1.postman_collection.json\" --insecure"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.2",
    "qrcode-generator": "^2.0.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "glob": "^14.0.4",
    "sift": "^17.1.4"
  }
}
